# Supabase Postgres. Get both from Project Settings > Database > Connection string.
# Pooled (Supavisor, transaction mode, port 6543) - used by the app at runtime (src/lib/db.ts).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) - used only by Prisma CLI for migrate/introspect (prisma.config.ts).
# The pooler doesn't support the DDL + shadow database Prisma migrate needs.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
